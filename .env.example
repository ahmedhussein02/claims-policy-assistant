# ---------- bot-server (copy to bot-server/.env) ----------
PORT=3001
ALLOWED_ORIGIN=http://localhost:3000

# Microsoft Entra External ID (filled in during step 3)
ENTRA_TENANT_ID=
ENTRA_ISSUER=
ENTRA_JWKS_URI=
ENTRA_AUDIENCE=
ENTRA_REQUIRED_SCOPE=Claims.Read

# Claims API (Azure Function)
CLAIMS_API_BASE_URL=http://localhost:7071/api

# OpenAI (replaces Azure OpenAI - documented deviation)
OPENAI_API_KEY=
CHAT_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
LLM_TEMPERATURE=0.1

# Azure AI Search
SEARCH_ENDPOINT=
SEARCH_API_KEY=
SEARCH_INDEX_NAME=policy-chunks

# RAG parameters
RAG_TOP_K=5
RAG_MIN_SCORE=0.5
CHUNK_SIZE_TOKENS=400
CHUNK_OVERLAP_TOKENS=60
FALLBACK_MESSAGE=I don't have sufficient information to answer this request. Please contact support.

# Azure Blob Storage (policy documents)
BLOB_CONNECTION_STRING=
BLOB_CONTAINER=policies

# Azure SQL (observability logs; same DB as claims)
SQL_CONNECTION_STRING=

# ---------- azure-function: see azure-function/local.settings.example.json ----------
# ---------- frontend: see frontend/.env.local.example ----------
